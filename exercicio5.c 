/* ex5 comparar 2 num inteiros*/
#include <stdio.h>

int main( void )
{
    int num1, num2; 

    printf( "Digite dois números inteiros: " );
    scanf( "%d%d", &num1, &num2 );

    if ( num1 == num2 ) {
        printf( "Os números são iguais\n" );
    } else if ( num1 > num2 ) {
        printf( "O primeiro é maior\n" );
    } else {
        printf( "O segundo é maior\n" );
    }

    return 0;
}
